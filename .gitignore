# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Secrets, API keys, credentials and tokens
.env
.env.*
*.env
*.key
*.pem
*.token
*.tokens
tokens.json
credentials.json
*secret*

# Financial dumps and confidential data (preserve example fixtures)
*portfolio*.json
!**/examples/*portfolio*.json
*balance*.json
!**/examples/*balance*.json
*activities*.json
!**/examples/*activities*.json
*.csv
!**/examples/*.csv

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
